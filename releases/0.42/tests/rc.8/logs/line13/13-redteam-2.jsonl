'path'])\nopen(L,'w').write('\\n'.join(paths)+'\\n');print('copied',len(paths))\nEOF\ngit -C $P init -q; git -C $P add --pathspec-from-file=$S/proj.paths && git -C $P -c user.email=t@e.invalid -c user.name=t commit -qm proj && echo committed\ngrep -E 'hooks/tests|destructive-guard|secret-leak|session-open|guarded_rm|hook_classification|light_onboarding|f267|orphan' $S/tests.list > $S/tests-agent.list; wc -l < $S/tests-agent.list; for f in $(awk '{print $2}' $S/tests-agent.list); do [ -e $P/$f ] || echo \"NOT DELIVERED: $f\"; done"}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"preference","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":89,"subtype":"success","api_error_status":null,"result":"**Публиковать можно с оговоркой (v0.42.0-rc.8).** Все пять проверенных путей прошли: чистая установка, обновление с v0.41.11, повторное обновление, возврат и права агента. Но один пункт среднего уровня важности остаётся открытым.\n\n## Вердикт: CAUTION (публиковать с оговоркой)\n\nПроверял кандидат v0.42.0-rc.8. Метка в моей копии совпадает с меткой на сервере, а обновление само поставило именно этот снимок. Проверка от 12.11.2026 на Linux (NixOS), bash 5.2. Всё запускал в одноразовых копиях во временной папке через обёртку-ограничитель. Исходное хранилище не изменилось, в настоящей домашней папке не появилось ни одной службы.\n\n## Что проверено\n\n| Проверка | Итог | На чём основано |\n|---|---|---|\n| Самопроверка методики | прошла | 21 из 21: заведомо плохой выпуск отклонён, хороший пропущен |\n| Список файлов выпуска (манифест) | прошла | 878 файлов, все совпадают с кандидатом; при двух повторных сборках список вышел байт в байт одинаковым |\n| Проверки на сервере для этого снимка | прошли | 33 успешны, 2 пропущены. Обе пропущенные - служебные: одна запускается только при нарезке выпуска, вторая - общий пункт проверки macOS, а оба её варианта прошли |\n| Чистая установка | прошла | установка и её самопроверка без ошибок; собственный тест чистой установки - 53 из 53 |\n| Обновление с v0.41.11 | прошло | 113 файлов, все 878 сверены с кандидатом. Свои настройки, расширения, память и файлы пространства сохранились байт в байт. Платформенная часть инструкций агента совпала с чистой установкой, пользовательский блок цел |\n| Повторное обновление | прошло | «Всё актуально», файлы платформы не изменились; переписались только отметки времени в служебной папке |\n| Возврат на v0.41.11 | прошёл | без подтверждения возврат отклонён и ничего не изменил. С подтверждением все 853 файла v0.41.11 на месте, файлов кандидата не осталось, все маркеры как до обновления. Обратный переход на кандидат тоже прошёл |\n| Права агента | прошли | разрешения в чистой и обновлённой установке одинаковые. Добавлены только три команды для отметки онбординга, и пишут они лишь служебную метку. Все 32 хука подключены, их файлы на месте |\n| Защитные наборы тестов в копии строго из манифеста | 18 из 19 | один тест не проверен: на NixOS нет `rm` по пути, который ждёт утилита |\n\nВсего прогнал 67 собственных наборов тестов. Сначала упали 10, и все 10 я свёл к особенностям этой машины, а не продукта. После устранения этих причин 8 прошли, а 2 на NixOS проверить нельзя.\n\n- **5 наборов** сбивала подставная утилита GitHub в тестовой среде: она изображает «вход выполнен».\n- **1 набор** сбивала сама обёртка-ограничитель: она принудительно выключает включение служб, а тест проверяет именно включение.\n- **1 набор** сбивало имя папки моей копии.\n- **1 наборe** не хватало модуля YAML; поставил его в одноразовое окружение.\n- **2 набора** требуют стандартных путей к системным программам, которых на NixOS нет.\n\n## Находки\n\n| № | Важность | Суть | Уверенность |\n|---|---|---|---|\n| 1 | **средняя** | У тех, кто ставил урезанный вариант (`--core`) до 0.42, каждое обновление заводит расписание фонового разбора заметок: дважды в день агент работает без человека. Человек это расписание не выбирал. Новая метка «урезанная установка» появилась только в 0.42, поэтому у старых установок защиты нет. Попытку включить службу перехватила обёртка, и она повторяется даже на запуске, где обновлять нечего. В списке изменений сказано, что такие установки ведут себя «как раньше»; в 0.41.11 было то же самое. Отключить можно командой удаления расписания | высокая |\n| 2 | низкая | Утилита безопасного удаления для агента на NixOS не находит `rm` и отказывает всегда. Это безопасно, но удалять ей ничего нельзя | высокая |\n| 3 | низкая | При правильном отказе от возврата в выводе лишняя строка «ОШИБКА… прервался на строке 1». Она похожа на сбой, хотя это штатный отказ | высокая |\n| 4 | низкая | После возврата у двух файлов остаётся право на запуск, и git копии считает их изменёнными | высокая |\n\nЧто я не считаю находками, потому что это описано в документации:\n- Три устаревших файла остались, так как их отслеживает git копии. Обновление печатает команду для их удаления.\n- В инструкциях навыков 71 незаполненная подстановка, ровно как в 0.41.11.\n\n## Граница выпуска\n\n- **Можно опираться:** урезанная установка, обновление с 0.41.11 с сохранением своих файлов, повторный запуск, защита от отката и сам откат, права агента.\n- **Не проверено:** полная установка со входом в GitHub и Claude; macOS здесь, только по проверкам на сервере; подлинность сборки и подпись выпуска (вне запрошенного объёма).\n- **До повторной проверки:** решить находку 1. Вариант первый - исправить и закрепить тестом «урезанная установка 0.41.11 → обновление → ни одного обращения к службам». Вариант второй - оформить исключение, которое принимает владелец продукта (не автор кода), со ссылкой на задачу.\n\nПо правилам методики для находки 1 нужна отдельная открытая задача в хранилище шаблона. Создать её отсюда я не смог: запись в GitHub в этой среде запрещена. Пока задачи нет, находка формально не закрыта. Если откроете задачу, текст для неё есть в отчёте.\n\nПолный отчёт на английском со всеми таблицами методики: /tmp/claude-1000/-home-iwe-test-IWE-FMT-exocortex-template/0d9cc28f-d2bd-47dd-9e91-f45c578ee42d/scratchpad/redteam-v0.42.0-rc.8.md\n\n**Публиковать можно, но с оговоркой:** открыт один пункт средней важности. Урезанные установки, сделанные до 0.42, получают при обновлении расписание фонового агента, которого человек не выбирал.","ttft_ms":12210,"type":"result","duration_ms":1391407,"uuid":"7801cdd8-3494-4a02-9d32-6ad2960f1f51","ttft_stream_ms":9794,"time_to_request_ms":240,"time_to_request_phases_ms":{"other":5,"system_prompt":36,"resume_other":1,"process_user_input":1,"input_command":153,"input_hooks":0,"conversation_append":0,"transcript_persist":3,"tool_pool_refresh":2,"init_message":3,"init_frame_send":4,"engine_pickup":1,"loop_entry":4,"message_prep":0,"model_config_wait":2,"autocompact":1,"request_announcements":5,"query_setup":0,"model_gates":1,"tool_schema_build":5,"message_normalization":2,"client_creation":2,"request_build":9},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":39,"time_to_request_cpu_ms":185,"time_to_request_major_faults":1237,"tool_schema_build_detail":{"betas_ms":0,"waits_ms":1,"placement_ms":1,"render_ms":3,"after_ms":0,"other_ms":0,"tools":12,"new_schemas":12},"message_normalization_detail":{"before_ms":0,"normalize_ms":2,"images_ms":0,"post_process_ms":0,"after_ms":0,"other_ms":0,"messages":20,"wire_messages":2},"request_build_detail":{"records_ms":0,"system_ms":1,"headers_ms":0,"cache_break_record_ms":1,"plans_ms":1,"retry_setup_ms":0,"sent_build_ms":2,"record_attempt_ms":3,"other_ms":1,"sent_build_safety_context_ms":0,"sent_build_cache_breakpoints_ms":0,"sent_build_surrogate_scan_ms":0},"first_content_frame_ms":9794,"queued_turn_count":0,"result_index"