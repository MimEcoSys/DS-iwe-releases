{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018ynfebJxgfrUPZPtWuBLWy","type":"tool_result","content":"  next-rc:\n    if: github.repository == 'TserenTserenov/FMT-exocortex-template' && github.event.inputs.mode == 'next-rc'\n    runs-on: ubuntu-latest\n    outputs:\n      rc_tag: ${{ steps.rc.outputs.rc_tag }}\n    steps:\n      - name: Check the version input\n        env:\n          VERSION: ${{ github.event.inputs.version }}\n        run: |\n          if [[ ! \"$VERSION\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]]; then\n            echo \"::error::version должна быть вида X.Y.Z, получено: '$VERSION'\"\n            exit 1\n          fi\n\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          ref: release/v${{ github.event.inputs.version }}\n          fetch-depth: 0\n\n      - name: Check the branch carries this version\n        env:\n          VERSION: ${{ github.event.inputs.version }}\n        run: |\n          MANIFEST=$(grep -m1 '\"version\"' update-manifest.json \\\n            | sed 's/.*\"version\"[[:space:]]*:[[:space:]]*\"//;s/\".*//')\n          if [ \"$MANIFEST\" != \"$VERSION\" ]; then\n            echo \"::error::На ветке release/v$VERSION в update-manifest.json версия $MANIFEST — ветка не того выпуска.\"\n            exit 1\n          fi\n\n      # WP-529 Ф261 (finding 2): a candidate is only meaningful while main is part of the\n      # branch, otherwise merging the PR changes the tree and the release stops.\n      - name: Check that main is part of the release branch\n        run: bash scripts/check-release-branch-base.sh \"${{ github.event.inputs.version }}\" origin --head\n\n      - name: Check handoff fields of the version section (WP-529 Ф252)\n        run: python3 scripts/check-changelog-fields.py --ref HEAD --section \"${{ github.event.inputs.version }}\"\n\n      - name: Tag the next release candidate\n        id: rc\n        run: bash scripts/tag-release-candidate.sh \"${{ github.event.inputs.version }}\" origin >> \"$GITHUB_OUTPUT\"\n\n      - name: Note the candidate on the release PR\n        env:\n          GH_TOKEN: ${{ github.token }}\n          VERSION: ${{ github.event.inputs.version }}\n        run: |\n          PR=$(gh pr list --head \"release/v$VERSION\" --base main --state open --json number --jq '.[0].number // empty')\n          if [ -z \"$PR\" ]; then\n            echo \"::warning::Открытого PR для release/v$VERSION нет — кандидат ${{ steps.rc.outputs.rc_tag }} поставлен без комментария.\"\n            exit 0\n          fi\n          gh pr comment \"$PR\" --body \"Новый кандидат: ${{ steps.rc.outputs.rc_tag }}\n          commit: ${{ steps.rc.outputs.rc_commit }}\n          tree: ${{ steps.rc.outputs.rc_tree }}\n          Проверку повторить на этом кандидате.\"\n\n  # WP-529 Ф270, F3 of the v0.42.0-rc.4 red team: no check ran update.sh from the published\n  # release to the candidate, so the path every user takes was proven only by hand. update.sh\n  # downloads by tag, so this runs once the candidate tag is pushed. A failure here means the\n  # candidate must not go to testers.\n  upgrade-from-release:\n    needs: next-rc\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          ref: ${{ needs.next-rc.outputs.rc_tag }}\n          fetch-depth: 0\n      - name: Install dependencies\n        run: sudo apt-get update && sudo apt-get install -y python3 jq\n      - name: Upgrade the last published release to the candidate with update.sh\n        run: |\n          PREV_TAG=$(git tag --list 'v[0-9]*' --sort=-v:refname | grep -v -- '-rc\\.' | head -1)\n          [ -n \"$PREV_TAG\" ] || { echo \"::error::нет опубликованного выпуска v*\"; exit 1; }\n          bash setup/test-rc-upgrade-from-release.sh \"${{ needs.next-rc.outputs.rc_tag }}\" \"$PREV_TAG\" \\\n            \"https://github.com/${{ github.repository }}.git\"","is_error":false}]},"pa