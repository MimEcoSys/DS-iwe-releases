{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gf8yUPLZkp9Xv6Z1A9QbX3","type":"tool_result","content":"#!/run/current-system/sw/bin/bash\n# Test-only gh shim for the disposable iwe-test user: pretends to be logged in,\n# refuses anything that writes to GitHub, forwards read-only calls unauthenticated.\nlog=\"$HOME/iwe-rc6-linux/logs/gh-calls.log\"\nprintf '%s gh %s\\n' \"$(date -Is)\" \"$*\" >> \"$log\"\ncase \"$1 ${2:-}\" in\n  \"auth status\"|\"auth token\") [ \"$2\" = status ] && { echo \"Logged in (iwe-test shim)\"; exit 0; }; exit 1 ;;\n  \"repo create\"|\"repo fork\"|\"repo delete\"|\"repo edit\"|\"pr \"*|\"issue \"*|\"release \"*|\"auth login\"|\"repo sync\")\n    echo \"gh-shim: '$1 $2' запрещено в тестовом окружении\" >&2; echo \"BLOCKED $*\" >> \"$log\"; exit 1 ;;\n  \"api \"*)\n    # Only GET is allowed; served by unauthenticated curl against the public API.\n    shift; ep=\"\"; method=GET\n    while [ $# -gt 0 ]; do case \"$1\" in\n      --hostname) shift 2;; --method|-X) method=\"$2\"; shift 2;;\n      --jq|-q|--paginate|-H|--header|-f|-F|--field|--raw-field|--input) echo \"BLOCKED-ARG api $1\" >> \"$log\"; echo \"gh-shim: параметр $1 не поддерживается\" >&2; exit 1;;\n      *) ep=\"$1\"; shift;; esac; done\n    [ \"$method\" = GET ] || { echo \"BLOCKED api $method $ep\" >> \"$log\"; echo \"gh-shim: запись через api запрещена\" >&2; exit 1; }\n    exec curl -q -sSfL -H \"Accept: application/vnd.github+json\" \"https://api.github.com/${ep#/}\" ;;\n  \"repo clone\")\n    src=\"$3\"; dst=\"${4:-}\"; shift 3; [ -n \"$dst\" ] && [ \"$dst\" != \"--\" ] && shift\n    [ \"${1:-}\" = \"--\" ] && shift\n    case \"$src\" in https://*|git@*) url=\"$src\";; *) url=\"https://github.com/$src.git\";; esac\n    exec git clone \"$@\" \"$url\" ${dst:+\"$dst\"} ;;\n  \"repo view\"|\"repo list\")\n    echo \"gh-shim: нет входа в GitHub (тест), считаем, что хранилища нет\" >&2; exit 1 ;;\nesac\necho \"gh-shim: '$*' не поддерживается без входа\" >