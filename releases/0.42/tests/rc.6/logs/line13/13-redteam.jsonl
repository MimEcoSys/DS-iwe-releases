MISSING\"].append(e[\"path\"]); continue\n    if hashlib.sha256(open(f,\"rb\").read()).hexdigest()!=e[\"sha256\"]: c[\"DIFFERS\"].append(e[\"path\"])\n    if modes.get(e[\"path\"])==\"100755\" and not os.access(f,os.X_OK): c[\"NOEXEC\"].append(e[\"path\"])\nfor k,v in c.items(): print(k,len(v),\" \".join(v[:8]))\nprint(\"TOTAL\",len(want[\"files\"]))\nPY\n}\ninstall_tag() { # tag\n  git clone -q \"$MIRROR\" \"$TPL\" && git -C \"$TPL\" checkout -q \"$1\" && git -C \"$TPL\" remote set-url origin \"$UP\" || return 1\n  bash \"$TPL/setup.sh\" --core > \"$LOG/setup-$1.log\" 2>&1; echo \"setup --core rc=$?\"\n}\nsentinels() {\n  R=$(head -c 24 /dev/urandom | base64 | tr -d '/+=')\n  mkdir -p \"$TPL/extensions\"; echo \"sentinel $R\" > \"$TPL/extensions/rt-sentinel.md\"\n  [ -f \"$TPL/params.yaml\" ] || cp \"$TPL/params.yaml.example\" \"$TPL/params.yaml\"\n  echo \"rt_sentinel: $R\" >> \"$TPL/params.yaml\"\n  mkdir -p \"$TPL/.claude\"; printf '{\"permissions\":{\"allow\":[\"Bash(echo rt-%s)\"]}}\\n' \"$R\" > \"$TPL/.claude/settings.local.json\"\n  # a user edit of a platform-owned file inside USER-SPACE block of CLAUDE.md\n  python3 -I - \"$TPL/CLAUDE.md\" \"$R\" <<'PY'\nimport sys; p,r=sys.argv[1:3]; s=open(p,encoding=\"utf-8\").read()\ns=s.replace(\"<!-- /USER-SPACE -->\",\"rt-user-rule %s\\n<!-- /USER-SPACE -->\"%r,1) if \"<!-- /USER-SPACE -->\" in s else s+\"\\nrt-user-tail %s\\n\"%r\nopen(p,\"w\",encoding=\"utf-8\").write(s)\nPY\n  # an edit of a plain platform file (should be preserved or reported, never silently lost)\n  echo \"# rt-local-edit $R\" >> \"$TPL/memory/navigation.md\"\n  for g in \"$WS\"/DS-*/; do [ -d \"$g\" ] && echo \"gov $R\" > \"$g/rt-sentinel.md\"; done\n  ( cd \"$TPL\" && sha256sum extensions/rt-sentinel.md params.yaml .claude/settings.local.json ) > \"$LOG/sentinels.sha\"\n  grep -c \"$R\" \"$TPL/CLAUDE.md\" \"$TPL/memory/navigation.md\" > \"$LOG/sentinel-grep.txt\"; echo \"$R\" > \"$LOG/sentinel.id\"\n}\ncheck_sentinels() {\n  ( cd \"$TPL\" && sha256sum -c \"$LOG/sentinels.sha\" 2>&1 ) | sed 's/^/  /'\n  R=$(cat \"$LOG/sentinel.id\")\n  echo \"  CLAUDE.md user line: $(grep -c \"$R\" \"$TPL/CLAUDE.md\")  navigation.md edit: $(grep -c \"$R\" \"$TPL/memory/navigation.md\")\"\n  for g in \"$WS\"/DS-*/; do [ -d \"$g\" ] && echo \"  gov $(basename \"$g\"): $(cat \"$g/rt-sentinel.md\" 2>/dev/null || echo LOST)\"; done\n}\nupd() { # label channel args...\n  local label=\"$1\" ch=\"$2\"; shift 2\n  local rc=0\n  (cd \"$TPL\" && IWE_UPDATE_CHANNEL=\"$ch\" bash update.sh \"$@\") > \"$LOG/upd-$label.log\" 2>&1 < \"${UPD_STDIN:-/dev/null}\" || rc=$?\n  echo \"update[$label] channel=$ch args=$* rc=$rc\"\n  grep -m2 -E 'Канал поставки|ВЕРДИКТ|Всё актуально|ОТКАТ|Отменено|Остановлено|ОШИБКА' \"$LOG/upd-$label.log\" | sed 's/^/  | /'\n  return 0\n}\n\ncase \"$CMD\" in\nfresh)\n  install_tag v0.42.0-rc.6\n  echo \"install-mode: $(cat \"$WS/.iwe-install-mode\" 2>/dev/null || echo none)\"\n  cmp_manifest v0.42.0-rc.6\n  echo \"unresolved placeholders in workspace CLAUDE.md: $(grep -o '{{[A-Z_]*}}' \"$WS/CLAUDE.md\" 2>/dev/null | sort -u | tr '\\n' ' ')\"\n  ls -la \"$WS\" | sed 's/^/  ws: /'\n  (cd \"$TPL\" && bash setup.sh --validate) > \"$LOG/validate.log\" 2>&1; echo \"setup --validate rc=$?\"; tail -4 \"$LOG/validate.log\"\n  snap \"$LOG/s1\"; bash \"$TPL/setup.sh\" --core > \"$LOG/setup-2.log\" 2>&1; echo \"second setup --core rc=$?\"; snap \"$LOG/s2\"\n  echo \"second-setup changed files: $(diff \"$LOG/s1\" \"$LOG/s2\" | grep -c '^[<>]')\"; diff \"$LOG/s1\" \"$LOG/s2\" | head -10\n  ;;\nfullsetup)\n  git clone -q \"$MIRROR\" \"$TPL\" && git -C \"$TPL\" checkout -q v0.42.0-rc.6 && git -C \"$TPL\" remote set-url origin \"$UP\"\n  rc=0; (cd \"$TPL\" && bash setup.sh </dev/null) > \"$LOG/fullsetup.log\" 2>&1 || rc=$?; echo \"setup (full, SETUP_CI=1) rc=$rc\"\n  tail -25 \"$LOG/fullsetup.log\"\n  ;;\nupgrade)\n  install_tag v0.41.11\n  cmp_manifest v0.41.11 | head -4\n  sentinels\n  snap \"$LOG/pre\"\n  upd check rc --check