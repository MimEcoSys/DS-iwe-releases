.sh > $L/setup.log 2>&1 </dev/null; R \"fresh setup.sh full rc=$?\"\nR \"fresh vs manifest: $(cmpman $RC)\"\ngrep -rIl --exclude-dir=.git '{{[A-Z_]*}}' $WS/CLAUDE.md $TPL/.claude 2>/dev/null | head -5 | sed 's/^/UNRESOLVED /' >> $L/results.txt\nmkdir -p $TPL/extensions; head -c 64 /dev/urandom | base64 > $TPL/extensions/rt-sentinel.md\n[ -f $TPL/params.yaml ] || cp $TPL/params.yaml.example $TPL/params.yaml; echo \"rt_sentinel: $RANDOM\" >> $TPL/params.yaml\nsha256sum $TPL/extensions/rt-sentinel.md $TPL/params.yaml > $L/sentinels.sha\nsnap $L/s0.sha\n(cd $TPL && IWE_UPDATE_CHANNEL=rc bash update.sh --yes) > $L/u1.log 2>&1 </dev/null; rc=$?\nsnap $L/s1.sha; R \"rc->rc rerun rc=$rc uptodate=$(grep -c 'Всё актуально' $L/u1.log) changed_files=$(diff $L/s0.sha $L/s1.sha | grep -c '^>')\"\n(cd $TPL && IWE_UPDATE_CHANNEL=release bash update.sh --yes) > $L/rb1.log 2>&1 </dev/null; rc=$?\nsnap $L/s2.sha; R \"rollback --yes (no consent) rc=$rc changed_files=$(diff $L/s1.sha $L/s2.sha | grep -c '^>') channel=$(grep -m1 'Канал поставки' $L/rb1.log)\"\n(cd $TPL && echo no | IWE_UPDATE_CHANNEL=release bash update.sh) > $L/rb2.log 2>&1; rc=$?\nsnap $L/s3.sha; R \"rollback answer=no rc=$rc changed_files=$(diff $L/s2.sha $L/s3.sha | grep -c '^>')\"\n(cd $TPL && printf 'ROLLBACK\\ny\\ny\\ny\\n' | IWE_UPDATE_CHANNEL=release bash update.sh) > $L/rb3.log 2>&1; rc=$?\nREL=$(grep -m1 -oE 'v0\\.[0-9]+\\.[0-9]+' <(grep 'Канал поставки' $L/rb3.log)); R \"rollback ROLLBACK rc=$rc to=$REL vs: $(cmpman ${REL:-v0.41.11})\"\nsha256sum -c --quiet $L/sentinels.sha && R \"sentinels after rollback: kept\" || R \"sentinels after rollback: LOST\"\n(cd $TPL && IWE_UPDATE_CHANNEL=release bash update.sh --yes) > $L/rb4.log 2>&1 </dev/null; R \"release rerun after rollback rc=$? uptodate=$(grep -c 'Всё актуально' $L/rb4.log)\"\n(cd $TPL && IWE_UPDATE_CHANNEL=rc bash update.sh --yes) > $L/fw.log 2>&1 </dev/null; R \"return to rc rc=$? vs: $(cmpman $RC)\"\nsha256sum -c --quiet $L/sentinels.sha && R \"sentinel