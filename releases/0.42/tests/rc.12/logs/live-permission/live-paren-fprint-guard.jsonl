{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013kWfZCrBg9Wcr4qC6WymkX","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# PreToolUse:Bash guard — blocks irreversible operations: git (staging, history,\n3\t# push/reset/clean), filesystem (recursive forced rm — only through\n4\t# .claude/bin/guarded-rm), prod DB (psql DROP/TRUNCATE/DELETE without WHERE),\n5\t# GitHub repo deletion. Exit 2 = block.\n6\tset -euo pipefail\n7\t\n8\tblock() {\n9\t  echo \"BLOCKED: $1\" >&2\n10\t  exit 2\n11\t}\n12\t\n13\t# Outcomes of this hook: 0 = allowed, 2 = forbidden OR the check itself failed.\n14\t# Claude Code treats only exit code 2 as a block, so any other non-zero exit (a\n15\t# missing perl or jq, a command failing under `set -e`) would let the call through.\n16\t# Every unexpected exit is turned into a block instead (issue #940).\n17\tfail_check() {\n18\t  block \"ошибка проверки destructive-guard ($1) — команда не пропущена. Разовая необходимость: CC_ALLOW_DESTRUCTIVE_INPUT=1 из реального шелла пилота.\"\n19\t}\n20\ton_exit() {\n21\t  local rc=$?\n22\t  if [ \"$rc\" -ne 0 ] && [ \"$rc\" -ne 2 ]; then\n23\t    fail_check \"неожиданный выход, код $rc\"\n24\t  fi\n25\t}\n26\ttrap on_exit EXIT\n27\t\n28\t# matches TEXT <grep options and pattern...> — 0 = match, 1 = no match. A grep or printf that\n29\t# FAILS (exit code 2 or more: a broken binary, a bad pattern) is a failed check and blocks;\n30\t# inside `if cmd | grep -q ...` it used to read as \"no match\" and let the call through.\n31\t# `grep -c` reads all its input, so an early exit of grep cannot raise SIGPIPE in printf.\n32\tmatches() {\n33\t  local text=$1 feed=0 found=0\n34\t  shift\n35\t  { printf '%s\\n' \"$text\" | grep -c \"$@\" >/dev/null; feed=${PIPESTATUS[0]} found=${PIPESTATUS[1]}; } || true\n36\t  [ \"$feed\" -eq 0 ] || fail_check \"printf, код $feed\"\n37\t  case \"$found\" in\n38\t    0|1) return \"$found\" ;;\n39\t    *) fail_check \"grep, код $found\" ;;\n40\t  esac\n41\t}\n42\t\n43\t# Bypass: only from the pilot's real shell (the same contract as secret-leak-block.sh —\n44\t# the hook reads its own process env, not the command text, so the agent cannot set it for itself).\n45\t# Strict comparison with \"1\" (not -n) — the same inconsistency in secret-leak-block.sh\n46\t# (there it is -n) is acceptable for existing code, but should not be copied into a new one\n47\t# (Codex peer review, WP-544 Phase 1, 20.08): -n would let CC_ALLOW_DESTRUCTIVE_INPUT=0 through as a bypass.\n48\t# First thing, before parsing the input: the pilot's bypass must work even with a broken jq.\n49\t[ \"${CC_ALLOW_DESTRUCTIVE_INPUT:-}\" = \"1\" ] && exit 0\n50\t\n51\t# Portable timeout (same helper as rule-engine.sh:_safe_timeout — kept local,\n52\t# not sourced, since this hook has no other dependency on rule-engine.sh).\n53\t# Plain `timeout` is a GNU coreutils binary, not part of base macOS: on a\n54\t# clean Mac install (no Homebrew coreutils) it is simply absent, `command not\n55\t# found` exits 127, and the `if !` below treats that identically to a real jq\n56\t# failure — every Bash call gets fail-closed blocked (issue #754).\n57\t_safe_timeout() {\n58\t  local t=\"$1\"; shift\n59\t  if command -v gtimeout &>/dev/null; then\n60\t    gtimeout \"$t\" \"$@\"\n61\t  elif command -v timeout &>/dev/null; then\n62\t    timeout \"$t\" \"$@\"\n63\t  else\n64\t    perl -e \"alarm $t; exec @ARGV\" -- \"$@\"\n65\t  fi\n66\t}\n67\t\n68\t# Read stdin once: a pipe/redirected fd is fully drained by the first jq call,\n69\t# so a second `jq` reading raw stdin always sees EOF and returns empty — this\n70\t# silently zeroed out $CWD on every invocation (found WP-547, 03.09, while\n71\t# verifying the stash-pop/apply check below, which depends on the real cwd).\n72\tHOOK_INPUT=$(cat 2>/dev/null || true)\n73\t\n74\t# Fail-closed on a malformed/schema-invalid envelope (WP-544 Д22, peer session\n75\t# 2026-09-08-25-wp544-continue-f7, Codex). The old `jq ... // empty || true`\n76\t# swallowed any jq parse error into an empty $CMD, and the next line read\n77\t# that as \"no command, nothing to check\" and exited 0 — a truncated payload\n78\t# with a real `rm -rf /x` inside it passed silently (reproduced live). `jq -e`\n79\t# on the whole envelope fails (non-zero exit) on a parse error, a non-object\n80\t# root, a missing/null/non-string/empty `tool_input.command`, or `jq` itself\n81\t# missing — none of those can be told apart from an actually-dangerous\n82\t# command with certainty, so all of them block rather than pass through.\n83\t# Never echo the raw payload here: it can carry command text with secrets.\n84\t# `timeout 5` on every jq call over $HOOK_INPUT (defense-in-depth, cold review\n85\t# WP-544 Д22, 08.09): jq reads over a pipe so it isn't hit by the ARG_MAX bug\n86\t# above, but nothing bounded how long it could run on a pathological payload\n87\t# either — a hang here would hang the hook, and by the same fail-closed logic\n88\t# as the rest of this block, a hung/killed jq (exit 124) blocks too.\n89\tif ! printf '%s' \"$HOOK_INPUT\" | _safe_timeout 5 jq -e \\\n90\t  'type == \"object\" and (.tool_input | type) == \"object\" and (.tool_input.command | type) == \"string\" and (.tool_input.command | length) > 0' \\\n91\t  >/dev/null 2>&1; then\n92\t  block \"не удалось разобрать вход хука, либо tool_input.command отсутствует/пустой/неверного типа — блокирую как неопределённо опасный запрос.\"\n93\tfi\n94\t# `|| block ...`, not a bare assignment: under `set -e` a failing command\n95\t# substitution assigned straight to a variable kills the script with jq's own\n96\t# raw exit code, bypassing block()'s deliberate exit 2 — the same \"crash\n97\t# instead of a decision\" class as the ARG_MAX bug above. This jq call should\n98\t# never actually fail here (the identical content just parsed successfully\n99\t# one line up), but \"should never fail\" is exactly the assumption Д22 exists\n100\t# to not make.\n101\tCMD=$(printf '%s' \"$HOOK_INPUT\" | jq -r '.tool_input.command') || block \"jq отказал при извлечении команды после успешной валидации — блокирую.\"\n102\tCWD=$(printf '%s' \"$HOOK_INPUT\" | jq -r '.cwd // .tool_input.cwd // empty' 2>/dev/null || true)\n103\tHOOK_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n104\tWORKSPACE_ROOT=\"$(cd \"$HOOK_DIR/../..\" && pwd -P)\"\n105\tGUARDED_RM=\"$WORKSPACE_ROOT/.claude/bin/guarded-rm\"\n106\t\n107\t# --- what this hook is allowed to look at (WP-545, 06.09) -------------------\n108\t#\n109\t# Every check below used to match against the raw Bash call text. Two live\n110\t# false positives in one session showed what that costs:\n111\t#   * writing a document through `cat > file <<'EOF' ... EOF` was refused as\n112\t#     `rm -rf`, because the check greps `rm`, a `-r`-ish flag and a `-f`-ish\n113\t#     flag ANYWHERE in the call: `rm -f \"$PROMPT_FILE\"` (a temp-file cleanup)\n114\t#     supplied two of them and the unrelated `--add-dir` of another command\n115\t#     supplied the \"recursive\" one;\n116\t#   * a session-close call was refused as `git add .`, because the standalone\n117\t#     `.` of `. \"$HOME/.../publish-gate.sh\"` (shell `source`) sat on a LATER\n118\t#     LINE of the same call, and the segment splitter did not treat a newline\n119\t#     as a command separator, so it landed inside the `git add` segment.\n120\t#\n121\t# So the text scanned is narrowed twice, before any check runs: heredoc bodies\n122\t# sent to data commands are removed, while bodies sent to literal shell/SQL\n123\t# interpreters remain; a newline separates commands the same way `;` does.\n124\tCMD_EXEC=$(printf '%s' \"$CMD\" | perl -e '\n125\t  # Read via stdin, not $ENV{CMD_SCAN}: a command text passed through the\n126\t  # process environment is subject to the same execve ARG_MAX as argv (found\n127\t  # by cold review, WP-544 Д22, 08.09 — a ~1.1MB command crashed this call\n128\t  # with \"Argument list too long\" (exit 126) instead of reaching block() or\n129\t  # exit 0, bypassing every check below it). Stdin has no such limit.\n130\t  my $text = do { local $/; <STDIN> };\n131\t  my @lines = split(/\\n/, $text, -1);\n132\t  my (@out, @pending);\n133\t  # Скан состояния кавычек — чистая функция (состояние, текст): заголовок с\n134\t  # переносами сканируется инкрементально, каждый новый сегмент один раз,\n135\t  # состояние переносится между итерациями. Прежняя continued_header заново\n136\t  # проходила всю уже склеенную строку на каждом переносе — квадратичное\n137\t  # время на длинных `\\`-цепочках (issue #1148).\n138\t  sub scan_quote_state {\n139\t    my ($line, $quote) = @_;\n140\t    for (my $i = 0; $i < length($line); $i++) {\n141\t      my $char = substr($line, $i, 1);\n142\t      if (defined $quote) {\n143\t        if ($quote ne chr(39) && $char eq \"\\\\\" && $i + 1 < length($line)) { $i++; next; }\n144\t        undef $quote if $char eq $quote;\n145\t      } elsif ($char eq \"\\\\\" && $i + 1 < length($line)) {\n146\t        $i++;\n147\t      } elsif ($char eq chr(39) || $char eq q{\"}) {\n148\t        $quote = $char;\n149\t      }\n150\t    }\n151\t    return $quote;\n152\t  }\n153\t\n154\t  sub is_data_command {\n155\t    my ($first, $next) = @_;\n156\t    return 1 if lc($first) =~ /^(?:cat|echo|printf|test|\\[|type|which|python[0-9.]*|perl|jq|sed|awk|grep|rg|tee|head|tail|wc|sort|uniq|cut|ls)$/;\n157\t    return 1 if lc($first) eq q{command} && ($next // q{}) =~ /^-[vV]$/;\n158\t    return 0;\n159\t  }\n160\t\n161\t  sub heredoc_recipient {\n162\t    my ($fragment) = @_;\n163\t    my @words = grep { length } split(/\\s+/, $fragment);\n164\t    # Data commands may mention an interpreter as a filename or argument.\n165\t    # Their heredoc is still data; aliases/functions changing the command\n166\t    # meaning are dynamic and outside this static check.\n167\t    my $first = $words[0] // q{};\n168\t    $first =~ s/<<-?.*$//;\n169\t    $first =~ s/^[!({]+//;\n170\t    $first =~ s{^.*[/\\\\]}{};\n171\t    $first =~ s/[;)}]+$//;\n172\t    $first =~ s/^[\\x27\"]+|[\\x27\"]+$//g;\n173\t    $first =~ s/\\.exe$//i;\n174\t    return 0 if is_data_command($first, $words[1]);\n175\t    # A wrapper or remote shell may carry the interpreter. For other commands,\n176\t    # scanning later words errs toward keeping data, not discarding runnable code.\n177\t    for my $word (@words) {\n178\t      $word =~ s/<<-?.*$//;\n179\t      $word =~ s/^[!({]+//;\n180\t      $word =~ s{^.*[/\\\\]}{};\n181\t      $word =~ s/[;)}]+$//;\n182\t      $word =~ s/^[\\x27\"]+|[\\x27\"]+$//g;\n183\t      $word =~ s/\\.exe$//i;\n184\t      return 1 if lc($word) =~ /^(?:(?:ba|z|k|da)?sh|ssh|psql|mysql|sqlite3)$/;\n185\t    }\n186\t    return 0;\n187\t  }\n188\t\n189\t  sub data_command_before_heredoc {\n190\t    my ($fragment) = @_;\n191\t    $fragment =~ s/^\\s+//;\n192\t    # Assignments and output redirects can precede a command, including one\n193\t    # placed to the right of the heredoc operator.\n194\t    while ($fragment =~ s/^(?:[A-Za-z_][A-Za-z0-9_]*=\\S+|\\d*(?:>>|<>|<&|>&|>\\||>|<)\\s*\\S+)\\s*//) {}\n195\t    $fragment =~ s/^\\s*(?:(?:if|then|else|do)\\b\\s*)+//;\n196\t    my @words = grep { length } split(/\\s+/, $fragment);\n197\t    while (@words) {\n198\t      if (lc($words[0]) eq q{env}) {\n199\t        shift @words;\n200\t        shift @words while @words && $words[0] =~ /^[A-Za-z_][A-Za-z0-9_]*=/;\n201\t      } elsif (lc($words[0]) eq q{sudo}) {\n202\t        shift @words;\n203\t        while (@words && $words[0] =~ /^-/) {\n204\t          my $option = shift @words;\n205\t          shift @words if @words && $option =~ /^(?:-u|--user)$/;\n206\t        }\n207\t      } else { last; }\n208\t    }\n209\t    my $first = $words[0] // q{};\n210\t    $first =~ s/^[!({]+//;\n211\t    $first =~ s{^.*[/\\\\]}{};\n212\t    $first =~ s/[;)}]+$//;\n213\t    $first =~ s/^[\\x27\"]+|[\\x27\"]+$//g;\n214\t    $first =~ s/\\.exe$//i;\n215\t    return is_data_command($first, $words[1]);\n216\t  }\n217\t\n218\t  sub right_command_stages {\n219\t    my ($tail) = @_;\n220\t    my @stages;\n221\t    my $stage = q{};\n222\t    my $quote;\n223\t    for (my $i = 0; $i < length($tail); $i++) {\n224\t      my $char = substr($tail, $i, 1);\n225\t      my $next = substr($tail, $i + 1, 1);\n226\t      my $prev = $i ? substr($tail, $i - 1, 1) : q{};\n227\t      if (defined $quote) {\n228\t        $stage .= $char;\n229\t        if ($quote ne chr(39) && $char eq \"\\\\\" && $i + 1 < length($tail)) {\n230\t          $stage .= $next; $i++; next;\n231\t        }\n232\t        undef $quote if $char eq $quote;\n233\t        next;\n234\t      }\n235\t      if ($char eq \"\\\\\" && $i + 1 < length($tail)) { $stage .= $char . $next; $i++; next; }\n236\t      if ($char eq chr(39) || $char eq q{\"}) { $quote = $char; $stage .= $char; next; }\n237\t      last if $char eq q{;};\n238\t      if ($char eq q{|} && $prev ne q{>}) {\n239\t        last if $next eq q{|};\n240\t        push @stages, $stage;\n241\t        $stage = q{};\n242\t        $i++ if $next eq q{&}; # |& forwards both streams into the next stage.\n243\t        next;\n244\t      }\n245\t      last if $char eq q{&} && $prev !~ /[<>]/ && $next ne q{>};\n246\t      $stage .= $char;\n247\t    }\n248\t    push @stages, $stage;\n249\t    return @stages;\n250\t  }\n251\t\n252\t  sub compound_end {\n253\t    my ($fragment) = @_;\n254\t    return q{fi} if $fragment =~ /^\\s*if\\b/;\n255\t    return q{done} if $fragment =~ /^\\s*(?:for|while|until|select)\\b/;\n256\t    return q{esac} if $fragment =~ /^\\s*case\\b/;\n257\t    return q{};\n258\t  }\n259\t\n260\t  sub compound_recipient {\n261\t    my ($source, $end) = @_;\n262\t    # Loop lists and case labels are data. Scan command fragments in the\n263\t    # construct, conservatively including every possible branch.\n264\t    if ($end eq q{done} && $source =~ /^\\s*(?:for|select)\\b/) {\n265\t      $source =~ s/^.*?(?:;|\\n)\\s*do\\b//s;\n266\t    } elsif ($end eq q{esac}) {\n267\t      $source =~ s/^\\s*case\\b.*?\\bin\\b//s;\n268\t      $source =~ s/(?:^|;;|;&|;;&)\\s*[^)\\n]*\\)/;/g;\n269\t    }\n270\t    for my $fragment (split(/[;\\n]/, $source)) {\n271\t      $fragment =~ s/^\\s*(?:(?:if|then|elif|else|do|while|until)\\b\\s*)+//;\n272\t      return 1 if heredoc_recipient($fragment);\n273\t    }\n274\t    return 0;\n275\t  }\n276\t\n277\t  sub line_heredocs {\n278\t    my ($line, $initial_quote, $initial_depth, $prior_group_source, $compound_frames) = @_;\n279\t    my (@specs, $start, $group_depth, $closed_prior_group, $last_heredoc_end);\n280\t    my $quote = $initial_quote;\n281\t    $start = 0;\n282\t    $group_depth = $initial_depth;\n283\t    $closed_prior_group = 0;\n284\t    $last_heredoc_end = -1;\n285\t    for (my $i = 0; $i < length($line); $i++) {\n286\t      my $char = substr($line, $i, 1);\n287\t      if (defined $quote) {\n288\t        if ($quote ne chr(39) && $char eq \"\\\\\" && $i + 1 < length($line)) { $i++; next; }\n289\t        undef $quote if $char eq $quote;\n290\t        next;\n291\t      }\n292\t      if ($char eq \"\\\\\" && $i + 1 < length($line)) { $i++; next; }\n293\t      if ($char eq chr(39) || $char eq q{\"}) { $quote = $char; next; }\n294\t      if ($char eq \"(\" || $char eq \"{\") { $group_depth++; next; }\n295\t      if ($char eq \")\" || $char eq \"}\") {\n296\t        $group_depth-- if $group_depth;\n297\t        $closed_prior_group = 1 if $initial_depth && !$group_depth;\n298\t        next;\n299\t      }\n300\t      my $prev = $i ? substr($line, $i - 1, 1) : q{};\n301\t      my $next = substr($line, $i + 1, 1);\n302\t      # These are redirection operators, not shell command separators.\n303\t      next if ($char eq q{&} && ($prev =~ /[<>|]/ || $next eq q{>}))\n304\t           || ($char eq q{|} && $prev eq q{>});\n305\t      if (!$group_depth && $char =~ /[;&|]/) {\n306\t        my $fragment = substr($line, $start, $i - $start);\n307\t        if ($start >= $last_heredoc_end) {\n308\t          my $end = compound_end($fragment);\n309\t          if (length $end) { push @$compound_frames, { source => q{}, line_start => $start, end => $end }; }\n310\t          elsif ($fragment =~ /^\\s*(fi|done|esac)\\b/ && @$compound_frames && $compound_frames->[-1]{end} eq $1) {\n311\t            pop @$compound_frames;\n312\t          }\n313\t        }\n314\t        $start = $i + 1;\n315\t        if ($char eq q{|} && $next eq q{&}) { $start++; $i++; }\n316\t        $closed_prior_group = 0;\n317\t        next;\n318\t      }\n319\t      next unless substr($line, $i, 2) eq \"<<\";\n320\t      next if substr($line, $i, 3) eq \"<<<\";\n321\t      my $tail = substr($line, $i);\n322\t      next unless $tail =~ /^<<(-?)\\s*(?!<)(?:([\\x27\"])([A-Za-z_][A-Za-z0-9_]*)\\2|([A-Za-z_][A-Za-z0-9_]*))/;\n323\t      my $match_length = length($&);\n324\t      my ($indent, $delim) = ($1 eq q{-}, defined $3 ? $3 : $4);\n325\t      my $recipient = substr($line, $start, $i - $start);\n326\t      my $prefix_is_data = data_command_before_heredoc($recipient);\n327\t      my @right_stages = right_command_stages(substr($line, $i + $match_length));\n328\t      my $right_recipient = $right_stages[0];\n329\t      if ($recipient =~ /^\\s*0?\\s*$/) {\n330\t        # A redirect may precede its command: `<<EOF bash`, `0<<EOF psql`.\n331\t        # Only an empty/FD prefix is commandless; `cat <<EOF bash` still feeds\n332\t        # cat, with bash merely an argument. Stop at the next shell separator.\n333\t        $recipient = $right_recipient;\n334\t      }\n335\t      my $compound_end = $recipient =~ /^\\s*(fi|done|esac)\\s*$/ ? $1 : q{};\n336\t      my $frame;\n337\t      if (length $compound_end && @$compound_frames && $compound_frames->[-1]{end} eq $compound_end) {\n338\t        # A redirect on fi/done/esac belongs to the entire compound command.\n339\t        $frame = pop @$compound_frames;\n340\t        $recipient = $frame->{source} . substr($line, $frame->{line_start}, $i - $frame->{line_start});\n341\t      }\n342\t      $recipient = $prior_group_source . $recipient if $closed_prior_group;\n343\t      # Keep any body addressed to a literal interpreter, regardless of the\n344\t      # heredoc FD. It may be read through /dev/fd/N or a later FD chain;\n345\t      # `bash 2<<EOF` can therefore be rejected conservatively.\n346\t      my $keep = $frame ? compound_recipient($recipient, $frame->{end}) : heredoc_recipient($recipient);\n347\t      $keep ||= heredoc_recipient($right_recipient) unless $prefix_is_data;\n348\t      # A data command can forward the body over a pipe to a literal shell or\n349\t      # SQL client. A later `;`/`&&` command does not receive that body.\n350\t      for my $stage (@right_stages[1 .. $#right_stages]) {\n351\t        $keep ||= heredoc_recipient($stage);\n352\t      }\n353\t      push @specs, { indent => $indent, delim => $delim, keep => $keep };\n354\t      $last_heredoc_end = $i + $match_length;\n355\t      $i += $match_length - 1;\n356\t    }\n357\t    if (!$group_depth && $start >= $last_heredoc_end) {\n358\t      my $fragment = substr($line, $start);\n359\t      my $end = compound_end($fragment);\n360\t      if (length $end) { push @$compound_frames, { source => q{}, line_start => $start, end => $end }; }\n361\t      elsif ($fragment =~ /^\\s*(fi|done|esac)\\b/ && @$compound_frames && $compound_frames->[-1]{end} eq $1) {\n362\t        pop @$compound_frames;\n363\t      }\n364\t    }\n365\t    for my $frame (@$compound_frames) {\n366\t      $frame->{source} .= substr($line, $frame->{line_start}) . \"\\n\";\n367\t      $frame->{line_start} = 0;\n368\t    }\n369\t    return (\\@specs, $quote, $group_depth);\n370\t  }\n371\t\n372\t  my ($header_quote, $header_group_depth, $group_source, @compound_frames) = (undef, 0, q{});\n373\t  for (my $line_no = 0; $line_no < @lines; $line_no++) {\n374\t    my $line = $lines[$line_no];\n375\t    if (@pending) {\n376\t      my $body = $pending[0];\n377\t      my $probe = $line;\n378\t      $probe =~ s/^\\t+// if $body->{indent};\n379\t      if ($probe eq $body->{delim}) { shift @pending; push @out, q{}; next; }\n380\t      push @out, $line if $body->{keep};\n381\t      next;\n382\t    }\n383\t    # Сегменты накапливаются списком и склеиваются один раз; состояние\n384\t    # кавычек переносится между сегментами явно ($seg_quote), поэтому каждый\n385\t    # сегмент сканируется один раз — линейное время (issue #1148).\n386\t    my @segments;\n387\t    my $joined = $line;\n388\t    my $seg_quote = $header_quote;\n389\t    while ($line_no + 1 < @lines) {\n390\t      my ($slashes) = $joined =~ /(\\\\+)$/;\n391\t      last unless defined $slashes && length($slashes) % 2;\n392\t      $seg_quote = scan_quote_state($joined, $seg_quote);\n393\t      last if defined $seg_quote && $seg_quote ne q{\"};\n394\t      push @segments, substr($joined, 0, -1);\n395\t      $joined = $lines[++$line_no];\n396\t    }\n397\t    $line = @segments ? join(q{}, @segments, $joined) : $joined;\n398\t    push @out, $line;\n399\t    my ($specs, $after_quote, $after_depth) = line_heredocs($line, $header_quote, $header_group_depth, $group_source, \\@compound_frames);\n400\t    push @pending, @$specs;\n401\t    $header_quote = $after_quote;\n402\t    $group_source = $after_depth ? $group_source . $line . \"\\n\" : q{};\n403\t    $header_group_depth = $after_depth;\n404\t  }\n405\t  # An unterminated body means this was not a heredoc at all (an arithmetic\n406\t  # shift, a quoted \"<<\" in prose): stripping there would hide real commands,\n407\t  # so the whole reduction is discarded rather than trusted.\n408\t  if (@pending) { print \"UNTERMINATED\"; exit 0; }\n409\t  print \"OK\", join(\"\\n\", @out);\n410\t')\n411\tif [ \"$CMD_EXEC\" = \"UNTERMINATED\" ]; then\n412\t  CMD_EXEC=\"$CMD\"\n413\telse\n414\t  CMD_EXEC=\"${CMD_EXEC#OK}\"\n415\tfi\n416\t\n417\t# #362: a top-level `cd` persists between Bash calls in Claude Code. Strip\n418\t# quoted spans before detecting command segments; `(cd ... && ...)` remains\n419\t# allowed because the opening parenthesis is not a top-level separator.\n420\tCD_RC=0\n421\tprintf '%s' \"$CMD_EXEC\" | perl -e '\n422\t  my $s = do { local $/; <STDIN> };\n423\t  $s =~ s/'\"'\"'[^'\"'\"']*'\"'\"'/ Q /g;\n424\t  $s =~ s/\"(?:\\\\.|[^\"\\\\])*\"/ Q /g;\n425\t  exit($s =~ /(?:^\\s*|[;&|\\n]\\s*)cd\\s+/ ? 0 : 1);\n426\t' || CD_RC=$?\n427\tcase \"$CD_RC\" in\n428\t  0) block \"верхнеуровневый cd запрещён: используй git -C <path>, абсолютный путь или (cd <path> && ...).\" ;;\n429\t  1) ;;\n430\t  *) fail_check \"perl, проверка cd, код $CD_RC\" ;;\n431\tesac\n432\t\n433\tif [ -n \"$CWD\" ]; then\n434\t  CWD_PHYSICAL=$(cd \"$CWD\" 2>/dev/null && pwd -P || printf '%s' \"$CWD\")\n435\t  if [ \"$CWD_PHYSICAL\" != \"$WORKSPACE_ROOT\" ] && \\\n436\t     matches \"$CMD_EXEC\" -E \"(^|[[:space:]\\\"'])(\\\\.claude/|scripts/|memory/)\"; then\n437\t    block \"root-relative path вызван из cwd=$CWD_PHYSICAL; используй абсолютный путь от $WORKSPACE_ROOT.\"\n438\t  fi\n439\tfi\n440\t\n441\t# One shell splitter, three readers (WP-545, 06.09). This file used to carry\n442\t# two near-identical copies of the same perl segment scanner and a third\n443\t# whole-command grep pass; each copy learned about `>&` redirects, newlines\n444\t# and command positions separately, or not at all. MODE=match answers \"which\n445\t# invocations of <name> does this call actually run\", MODE=count answers \"how\n446\t# many commands are in this call, and how many are <pattern>\".\n447\tSEGMENTER_PL='\n448\t  sub words {\n449\t    my ($text) = @_;\n450\t    my (@out, $word, $quote) = ();\n451\t    my $started = 0;\n452\t    for (my $i = 0; $i < length($text); $i++) {\n453\t      my $char = substr($text, $i, 1);\n454\t      $started = 1 if defined $quote || $char !~ /\\s/;\n455\t      if (defined $quote) {\n456\t        if ($char eq \"\\\\\" && $quote eq \"ansi\" && $i + 1 < length($text)) {\n457\t          # Decode what bash decodes inside dollar-single-quote: the flag -rf can be written -r\\x66.\n458\t          my $esc = substr($text, $i + 1, 1);\n459\t          my $tail = substr($text, $i + 1);\n460\t          my %simple = (a => \"\\a\", b => \"\\b\", e => chr(27), E => chr(27), f => \"\\f\", n => \"\\n\", r => \"\\r\", t => \"\\t\", v => chr(11));\n461\t          if ($esc eq \"x\" && $tail =~ /^x([0-9A-Fa-f]{1,2})/) {\n462\t            $word .= chr(hex $1);\n463\t            $i += length($1) + 1;\n464\t          } elsif ($tail =~ /^([0-7]{1,3})/) {\n465\t            $word .= chr(oct($1) & 255);\n466\t            $i += length($1);\n467\t          } elsif (($esc eq \"u\" && $tail =~ /^u([0-9A-Fa-f]{1,4})/) || ($esc eq \"U\" && $tail =~ /^U([0-9A-Fa-f]{1,8})/)) {\n468\t            $word .= chr(hex $1);\n469\t            $i += length($1) + 1;\n470\t          } elsif (exists $simple{$esc}) {\n471\t            $word .= $simple{$esc};\n472\t            $i++;\n473\t          } elsif ($esc eq \"c\" && $i + 2 < length($text)) {\n474\t            $word .= chr(ord(substr($text, $i + 2, 1)) & 31);\n475\t            $i += 2;\n476\t          } elsif ($esc eq chr(92) || $esc eq chr(39) || $esc eq q{\"} || $esc eq q{?}) {\n477\t            $word .= $esc;\n478\t            $i++;\n479\t          } else {\n480\t            $word .= $char;               # an unknown escape keeps its backslash\n481\t          }\n482\t        } elsif ($char eq \"\\\\\" && $quote eq q{\"} && $i + 1 < length($text) && substr($text, $i + 1, 1) =~ /[\\$`\"\\\\\\n]/) {\n483\t          # In double quotes a backslash escapes only $ ` \" \\ and a newline; in \"C:\\Git\\usr\" it stays.\n484\t          $word .= substr($text, ++$i, 1);\n485\t        } elsif ($char eq ($quote eq \"ansi\" ? chr(39) : $quote)) {\n486\t          undef $quote;\n487\t        } else {\n488\t          $word .= $char;\n489\t        }\n490\t      } elsif ($char eq q{$} && $i + 1 < length($text) && substr($text, $i + 1, 1) eq chr(39)) {\n491\t        # ANSI-C quoting (dollar + single quote): a backslash escapes the next char.\n492\t        $quote = \"ansi\";\n493\t        $i++;\n494\t      } elsif ($char eq q{$} && $i + 1 < length($text) && substr($text, $i + 1, 1) eq q{\"}) {\n495\t        # dollar-double-quote (locale translation) is an ordinary double-quoted string: drop the dollar.\n496\t        next;\n497\t      } elsif ($char eq q{\"} || $char eq chr(39)) {\n498\t        $quote = $char;\n499\t      } elsif ($char eq \"\\\\\" && $i + 1 < length($text)) {\n500\t        $word .= substr($text, ++$i, 1);\n501\t      } elsif ($char =~ /\\s/) {\n502\t        push @out, $word // q{} if $started;\n503\t        $word = q{};\n504\t        $started = 0;\n505\t      } else {\n506\t        $word .= $char;\n507\t      }\n508\t    }\n509\t    push @out, $word // q{} if $started;\n510\t    return @out;\n511\t  }\n512\t\n513\t  sub expand_literals {\n514\t    my ($text, $values) = @_;\n515\t    my ($out, $quote) = (q{}, undef);\n516\t    for (my $i = 0; $i < length($text); $i++) {\n517\t      my $char = substr($text, $i, 1);\n518\t      if (!defined $quote && $char eq q{$} && substr($text, $i + 1, 1) eq chr(39)) {\n519\t        $out .= $char . chr(39);\n520\t        $quote = \"ansi\";\n521\t        $i++;\n522\t        next;\n523\t      }\n524\t      if ($char eq chr(92) && (!defined $quote || $quote ne chr(39)) && $i + 1 < length($text)) {\n525\t        $out .= $char . substr($text, ++$i, 1);\n526\t        next;\n527\t      }\n528\t      if ($char eq chr(39) && (!defined $quote || $quote eq chr(39) || $quote eq \"ansi\")) {\n529\t        $quote = defined $quote ? undef : $char;\n530\t      } elsif ($char eq q{\"} && (!defined $quote || $quote eq q{\"})) {\n531\t        $quote = defined $quote ? undef : $char;\n532\t      } elsif ($char eq q{$} && (!defined $quote || ($quote ne chr(39) && $quote ne \"ansi\"))) {\n533\t        pos($text) = $i;\n534\t        if ($text =~ /\\G\\$(?:\\{([A-Za-z_][A-Za-z0-9_]*)\\}|([A-Za-z_][A-Za-z0-9_]*))/gc) {\n535\t          my $name = defined $1 ? $1 : $2;\n536\t          my $end = pos($text);\n537\t          if (exists $values->{$name}) {\n538\t            $out .= $values->{$name};\n539\t            $i = $end - 1;\n540\t            next;\n541\t          }\n542\t        }\n543\t      }\n544\t      $out .= $char;\n545\t    }\n546\t    return $out;\n547\t  }\n548\t\n549\t  sub lex_segments {\n550\t    my ($text) = @_;\n551\t    my (@out, $segment, $quote) = ((), q{}, undef);\n552\t    my $n = length($text);\n553\t    my $escaped_at = -1;\n554\t    for (my $i = 0; $i < $n; $i++) {\n555\t      my $char = substr($text, $i, 1);\n556\t      my $next = $i + 1 < $n ? substr($text, $i + 1, 1) : q{};\n557\t      if (defined $quote) {\n558\t        $segment .= $char;\n559\t        if ($char eq \"\\\\\" && ($quote eq q{\"} || $quote eq \"ansi\") && $i + 1 < $n) {\n560\t          $segment .= substr($text, ++$i, 1);\n561\t        } elsif ($char eq ($quote eq \"ansi\" ? chr(39) : $quote)) {\n562\t          undef $quote;\n563\t        }\n564\t      } elsif ($char eq q{$} && $next eq chr(39)) {\n565\t        $quote = \"ansi\";\n566\t        $segment .= $char . $next;\n567\t        $i++;\n568\t      } elsif ($char eq \"\\\\\" && $next eq \"\\n\") {\n569\t        # A backslash before a newline joins the lines and both vanish: r-backslash-newline-m is rm.\n570\t        $i++;\n571\t      } elsif ($char eq \"\\\\\" && $i + 1 < $n) {\n572\t        # An escaped character is literal, as in bash: an escaped quote opens no quote and an\n573\t        # escaped separator separates nothing. Splitting at one (\"conservative\" until rc.7) hid\n574\t        # the rest of the command from the rule for its name: `find … -exec cat {} \\; -delete`\n575\t        # (rc.6 red team, F1), `find \\( -name v \\) -delete` (rc.7 Linux check), `git add a\\;b -A`.\n576\t        # A string that a shell re-reads (`eval echo a\\; rm -rf x`) is re-split by the eval branch\n577\t        # of inspected_segments from its unescaped words.\n578\t        $segment .= $char . $next;\n579\t        $escaped_at = length $segment;\n580\t        $i++;\n581\t      } elsif ($char eq q{\"} || $char eq chr(39)) {\n582\t        $quote = $char;\n583\t        $segment .= $char;\n584\t      } elsif ($char eq q{#} && $escaped_at != length($segment) && ($segment eq q{} || $segment =~ /[ \\t]$/)) {\n585\t        # A comment runs to the end of the line; an apostrophe in it must not open a quote\n586\t        # that swallows the next lines (and a command hidden behind them).\n587\t        my $end = index($text, \"\\n\", $i);\n588\t        $i = ($end < 0 ? $n : $end) - 1;\n589\t      } elsif ($char eq q{$} && $next eq chr(123)) {\n590\t        pos($text) = $i;\n591\t        if ($text =~ /\\G\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}/gc) {\n592\t          my $end = pos($text);\n593\t          $segment .= substr($text, $i, $end - $i);\n594\t          $i = $end - 1;\n595\t        } else {\n596\t          $segment .= $char;\n597\t        }\n598\t      } elsif ($char eq chr(123) && $next eq chr(125)) {\n599\t        # `{}` — the placeholder of `find -exec` / `xargs -I {}`, not a brace group.\n600\t        $segment .= $char . $next;\n601\t        $i++;\n602\t      } elsif ($char eq q{&} && length($segment) && substr($segment, -1, 1) eq q{>}) {\n603\t        # `>&` fd-dup (`2>&1`, `>&2`) — part of the CURRENT command redirect,\n604\t        # not a separator (WP-544, 04.09: without this, a lone command ending\n605\t        # in `2>&1` was mis-split into two).\n606\t        $segment .= $char;\n607\t      } elsif ($char eq q{&} && $next eq q{>}) {\n608\t        $segment .= $char;\n609\t      } elsif ($char eq q{|} && length($segment) && substr($segment, -1, 1) eq q{>}) {\n610\t        $segment .= $char;                       # `>|` noclobber redirect\n611\t      } elsif ($char =~ /[;&|(){}\\n]/ || $char eq q{`}) {\n612\t        # A newline ends a command exactly like `;` does. Without it, every\n613\t        # later line of a multi-line call was glued onto the first command\n614\t        # of the call — how a `source` dot two lines below a `git add <path>`\n615\t        # was read as `git add .` (WP-545).\n616\t        my $operator = $char;\n617\t        if (($char eq q{|} || $char eq q{&}) && $next eq $char) {\n618\t          $operator .= $next;\n619\t          $i++;\n620\t        }\n621\t        push @out, [$segment, $operator];\n622\t        $segment = q{};\n623\t        $escaped_at = -1;\n624\t      } else {\n625\t        $segment .= $char;\n626\t      }\n627\t    }\n628\t    push @out, [$segment, q{}];\n629\t    my (%values, $previous, $conditional);\n630\t    for my $item (@out) {\n631\t      $item->[0] = expand_literals($item->[0], \\%values) if %values;\n632\t      my @tokens = words($item->[0]);\n633\t      $conditional = 1 if @tokens && $tokens[0] =~ /^(?:if|for|while|until|case|select)$/;\n634\t      # A pipeline/background/subshell/function may execute assignments in a\n635\t      # different process or later. Never turn that into a known safe command.\n636\t      $conditional = 1 if $item->[1] =~ /[(){}&|]/;\n637\t      if (@tokens && !grep { !/^[A-Za-z_][A-Za-z0-9_]*=/ } @tokens) {\n638\t        for my $token (@tokens) {\n639\t          my ($name, $value) = split(/=/, $token, 2);\n640\t          # Only literal words, without substitutions or shell metacharacters.\n641\t          unless ($value =~ m{^[A-Za-z0-9_./-]+$}) {\n642\t            # Computed values remain outside literal-name resolution. Do not\n643\t            # turn ordinary provider/path variables into new blanket blocks.\n644\t            if ($conditional && exists $values{$name}) { $values{$name} = \"IWE_UNCERTAIN_LITERAL\"; }\n645\t            else { delete $values{$name}; }\n646\t            next;\n647\t          }\n648\t          if ($conditional || ($previous // q{}) =~ /^(?:&&|\\|\\|)$/) {\n649\t            $value = \"IWE_UNCERTAIN_LITERAL\" if !exists $values{$name} || $values{$name} ne $value;\n650\t          }\n651\t          $values{$name} = $value;\n652\t        }\n653\t      } elsif (@tokens && $tokens[0] eq \"unset\") {\n654\t        unless (grep { /^-/ && !/^(?:-v|--)$/ } @tokens[1 .. $#tokens]) {\n655\t          for my $name (grep { /^[A-Za-z_][A-Za-z0-9_]*$/ } @tokens[1 .. $#tokens]) {\n656\t            if ($conditional && exists $values{$name}) { $values{$name} = \"IWE_UNCERTAIN_LITERAL\"; }\n657\t            else { delete $values{$name}; }\n658\t          }\n659\t        }\n660\t      }\n661\t      $previous = $item->[1];\n662\t    }\n663\t    return @out;\n664\t  }\n665\t\n666\t  sub segments { return map { $_->[0] } lex_segments($_[0]); }\n667\t\n668\t  # Basename of a command word: /bin/rm, /usr/bin/rm, C:\\Git\\usr\\bin\\rm.exe all name `rm`.\n669\t  # macOS and Windows can resolve /BIN/RM or GIT to the same executable; normalise\n670\t  # every command name, including data commands such as ECHO, before classification.\n671\t  sub command_base {\n672\t    my ($word) = @_;\n673\t    $word =~ s/[<>].*$//;                # rm>/dev/null names rm\n674\t    $word =~ s{^.*[/\\\\]}{};\n675\t    $word =~ s/\\.exe$//i;\n676\t    return lc($word);\n677\t  }\n678\t\n679\t  sub git_clean_would_delete {\n680\t    my @options = @_;\n681\t    # clean.requireForce=false makes even bare `git clean` destructive. Only an\n682\t    # effective dry-run proves that the invocation cannot remove files.\n683\t    my $dry_run = 0;\n684\t    for (my $i = 0; $i < @options; $i++) {\n685\t      my $token = $options[$i];\n686\t      last if $token eq \"--\";\n687\t      my ($long, $value) = split(/=/, $token, 2);\n688\t      if (length($long) >= 3 && index(\"--exclude\", $long) == 0) {\n689\t        $i++ unless defined $value;\n690\t        next;\n691\t      }\n692\t      if (length($long) >= 4 && index(\"--dry-run\", $long) == 0) { $dry_run = 1; next; }\n693\t      if (length($long) >= 5 && index(\"--no-dry-run\", $long) == 0) { $dry_run = 0; next; }\n694\t      next unless $token =~ /^-[A-Za-z]/;\n695\t      my $flags = substr($token, 1);\n696\t      for (my $j = 0; $j < length($flags); $j++) {\n697\t        my $flag = substr($flags, $j, 1);\n698\t        # -e, also at the end of -fde, consumes the next token. In -fen the\n699\t        # attached n is its pattern, not a dry-run flag.\n700\t        if ($flag eq \"e\") { $i++ if $j == length($flags) - 1; last; }\n701\t        $dry_run = 1 if $flag eq \"n\";\n702\t      }\n703\t    }\n704\t    return !$dry_run;\n705\t  }\n706\t\n707\t  sub rm_has_recursive_force {\n708\t    my @args = @_;\n709\t    my ($recursive, $force) = (0, 0);\n710\t    for my $token (@args) {\n711\t      last if $token eq \"--\";\n712\t      $token =~ s/\\d*[<>].*$// if $token =~ /^-/;\n713\t      if ($token =~ /^-([A-Za-z]+)$/) {\n714\t        my $flags = $1;\n715\t        $recursive = 1 if $flags =~ /[rR]/;\n716\t        $force = 1 if $flags =~ /f/;\n717\t      } elsif ($token =~ /^(--[A-Za-z]+)$/) {\n718\t        my $option = lc($1);\n719\t        $recursive = 1 if length($option) >= 3 && index(\"--recursive\", $option) == 0;\n720\t        $force = 1 if length($option) >= 3 && index(\"--force\", $option) == 0;\n721\t      }\n722\t    }\n723\t    return $recursive && $force;\n724\t  }\n725\t\n726\t  sub is_redirection {\n727\t    my ($word, $alone) = @_;\n728\t    return $alone ? ($word =~ /^(?:\\d*|&)(?:>>?|<<?|>&|<&|>\\|)$/) : ($word =~ /^(?:\\d*|&)(?:>>?|<<?|>&|<&|>\\|)./);\n729\t  }\n730\t\n731\t  sub command_indices {\n732\t    # Token positions where a command NAME is expected — the executable of the\n733\t    # segment, plus the standard \"run this command\" carriers. Anything else (a\n734\t    # word inside a quoted argument, prose in an echo) is an argument, never a\n735\t    # command, and must not arm a check.\n736\t    #\n737\t    # Wrappers are skipped WITH their own options: cold review 06.09 found\n738\t    # `timeout 5 rm -rf …`, `nice rm -rf …`, `sudo -u nobody rm -rf …`,\n739\t    # `env -i rm -rf …` and `xargs -n 1 rm -rf …` all passing, because the\n740\t    # first option (or a bare duration) took the command position and the real\n741\t    # command behind it was never looked at. The list is deliberately generous:\n742\t    # a wrapper skipped in error only means one more position is examined.\n743\t    my %option_with_argument = (\n744\t      sudo    => qr/^(?:-u|-g|-h|-p|-C|-r|-t|--user|--group|--host|--prompt|--close-from|--role|--type)$/,\n745\t      doas    => qr/^(?:-u|-C)$/,\n746\t      env     => qr/^(?:-u|--unset|-C|--chdir)$/,\n747\t      timeout => qr/^(?:-s|-k|--signal|--kill-after)$/,\n748\t      nice    => qr/^(?:-n|--adjustment)$/,\n749\t      ionice  => qr/^(?:-c|-n|-p|-P|-u)$/,\n750\t      stdbuf  => qr/^(?:-i|-o|-e|--input|--output|--error)$/,\n751\t      time    => qr/^(?:-o|-f|--output|--format)$/,\n752\t      xargs   => qr/^(?:-n|-P|-I|-L|-s|-E|-d|-a|--max-args|--max-procs|--max-chars|--delimiter|--arg-file)$/,\n753\t    );\n754\t    my %keyword = map { $_ => 1 } qw(! then do else elif if while until);\n755\t    my (@tokens) = @_;\n756\t    my @indices;\n757\t    my $i = 0;\n758\t    while ($i < @tokens) {\n759\t      if ($tokens[$i] =~ /^[A-Za-z_][A-Za-z0-9_]*=/ || $keyword{$tokens[$i]}) { $i++; next; }\n760\t      # A redirection in front of the command (`> log cmd`, `2>&1 cmd`) is not the command.\n761\t      if (is_redirection($tokens[$i], 1)) { $i += 2; next; }\n762\t      if (is_redirection($tokens[$i], 0)) { $i++; next; }\n763\t      my $name = command_base($tokens[$i]);\n764\t      last unless $name =~ /^(?:command|builtin|exec|env|nohup|time|sudo|doas|timeout|nice|ionice|stdbuf|setsid|xargs)$/;\n765\t      my $pattern = $option_with_argument{$name};\n766\t      $i++;\n767\t      # `timeout 5 cmd`: the duration is not an option and not the command.\n768\t      $i++ if $name eq \"timeout\" && $i < @tokens && $tokens[$i] =~ /^[0-9]+(?:\\.[0-9]+)?[smhd]?$/;\n769\t      while ($i < @tokens && $tokens[$i] =~ /^-/) {\n770\t        my $option = $tokens[$i];\n771\t        $i++;\n772\t        $i++ if defined $pattern && $option =~ $pattern && $i < @tokens;\n773\t      }\n774\t    }\n775\t    return () unless $i < @tokens;\n776\t    push @indices, $i;\n777\t    if (command_base($tokens[$i]) eq \"find\") {\n778\t      for (my $j = $i + 1; $j < $#tokens; $j++) {\n779\t        push @indices, $j + 1 if $tokens[$j] =~ /^-(?:exec|execdir)$/;\n780\t      }\n781\t    }\n782\t    return @indices;\n783\t  }\n784\t\n785\t  sub carried_indices {\n786\t    # Positions of the commands that find or xargs run once per found item: the command\n787\t    # after -exec/-execdir/-ok/-okdir of find, or the command behind xargs, each past\n788\t    # wrappers (`find ~ -exec env rm {} +`, `xargs -0 nice rm`, `busybox rm`). Such a\n789\t    # command needs no -r to delete a whole tree: the walk supplies every file (WP-529 Ф270,\n790\t    # RT2-1 of the v0.42.0-rc.2 red team).\n791\t    my @tokens = @_;\n792\t    my ($first) = command_indices(@tokens);\n793\t    return () unless defined $first;\n794\t    my @carried;\n795\t    push @carried, $first if grep { command_base($tokens[$_]) eq \"xargs\" } 0 .. $first - 1;\n796\t    push @carried, find_carried_indices(@tokens);\n797\t    return map { command_base($tokens[$_]) eq \"busybox\" && $_ < $#tokens ? $_ + 1 : $_ } @carried;\n798\t  }\n799\t\n800\t  sub find_carried_indices {\n801\t    # Positions of the commands find runs per item (-exec/-execdir/-ok/-okdir), past wrappers.\n802\t    my @tokens = @_;\n803\t    my ($first) = command_indices(@tokens);\n804\t    return () unless defined $first && command_base($tokens[$first]) eq \"find\";\n805\t    my @carried;\n806\t    for (my $j = $first + 1; $j < $#tokens; $j++) {\n807\t      next unless $tokens[$j] =~ /^-(?:exec|execdir|ok|okdir)$/;\n808\t      my ($inner) = command_indices(@tokens[$j + 1 .. $#tokens]);\n809\t      push @carried, $j + 1 + $inner if defined $inner;\n810\t    }\n811\t    return map { command_base($tokens[$_]) eq \"busybox\" && $_ < $#tokens ? $_ + 1 : $_ } @carried;\n812\t  }\n813\t\n814\t  sub shell_reads_stdin {\n815\t    my @args = @_;\n816\t    my $stdin_script = 0;\n817\t    for (my $i = 0; $i < @args; $i++) {\n818\t      next if is_redirection($args[$i], 0);\n819\t      if (is_redirection($args[$i], 1)) { $i++; next; }\n820\t      if ($args[$i] =~ /^(?:[-+]o|[-+]O|--rcfile|--init-file)$/) { $i++; next; }\n821\t      if ($args[$i] =~ /^([-+])([A-Za-z]+)$/) {\n822\t        my ($sign, $flags) = ($1, $2);\n823\t        for (my $j = 0; $j < length($flags); $j++) {\n824\t          my $flag = substr($flags, $j, 1);\n825\t          return 0 if $flag eq \"c\" && $sign eq \"-\";\n826\t          $stdin_script = $sign eq \"-\" if $flag eq \"s\";\n827\t          if ($flag eq \"o\" || $flag eq \"O\") {\n828\t            $i++ if $j == length($flags) - 1;\n829\t            last;\n830\t          }\n831\t        }\n832\t        next;\n833\t      }\n834\t      return 1 if $args[$i] eq \"--\" && $stdin_script;\n835\t      if ($args[$i] eq \"--\") { return $i == $#args; }\n836\t      next if $args[$i] =~ /^-/;\n837\t      return $stdin_script;            # Filename, or positional arguments with -s.\n838\t    }\n839\t    return 1;\n840\t  }\n841\t\n842\t  sub literal_output {\n843\t    my ($base, @args) = @_;\n844\t    die \"nonliteral shell input\\n\" if grep { /[\\$`]/ } @args;\n845\t    my %escapes = (n => \"\\n\", t => \"\\t\", r => \"\\r\", chr(92) => chr(92));\n846\t    if ($base eq \"echo\") {\n847\t      shift @args while @args && $args[0] =~ /^(?:-[neE]+|--)$/;\n848\t      my $output = join(\" \", @args);\n849\t      die \"unsupported echo escape in shell input\\n\" if $output =~ /\\\\/;\n850\t      return $output;\n851\t    }\n852\t    shift @args if @args && $args[0] eq \"--\";\n853\t    my $format = shift @args // q{};\n854\t    my $probe = $format;\n855\t    $probe =~ s/%%|%s//g;\n856\t    die \"unsupported printf format in shell input\\n\" if $probe =~ /%/ || $format =~ /\\\\(?![ntr\\\\])/;\n857\t    $format =~ s/\\\\([ntr\\\\])/$escapes{$1}/ge;\n858\t    my $slots = 0;\n859\t    while ($format =~ /%%|(%s)/g) { $slots++ if defined $1; }\n860\t    return sprintf($format) unless $slots;\n861\t    my $output = q{};\n862\t    do {\n863\t      my @group = splice(@args, 0, $slots);\n864\t      push @group, q{} while @group < $slots;\n865\t      $output .= sprintf($format, @group);\n866\t      die \"literal shell input exceeds 1 MiB\\n\" if length($output) > 1048576;\n867\t    } while (@args);\n868\t    return $output;\n869\t  }\n870\t\n871\t  sub piped_scripts {\n872\t    my @lexed = @_;\n873\t    my @scripts;\n874\t    for (my $i = 0; $i + 1 < @lexed; $i++) {\n875\t      next unless $lexed[$i][1] eq q{|};\n876\t      my @producer = words($lexed[$i][0]);\n877\t      my @consumer = words($lexed[$i + 1][0]);\n878\t      my ($source) = command_indices(@producer);\n879\t      my ($sink) = command_indices(@consumer);\n880\t      next unless defined $source && defined $sink;\n881\t      my $base = command_base($producer[$source]);\n882\t      next unless $base =~ /^(?:echo|printf)$/;\n883\t      next unless command_base($consumer[$sink]) =~ /^(?:ba|z|k|da|a)?sh$/;\n884\t      next unless shell_reads_stdin(@consumer[$sink + 1 .. $#consumer]);\n885\t      push @scripts, literal_output($base, @producer[$source + 1 .. $#producer]);\n886\t    }\n887\t    return @scripts;\n888\t  }\n889\t\n890\t  sub inspected_segments {\n891\t    my ($text, $depth) = @_;\n892\t    $depth //= 0;\n893\t    my @lexed = lex_segments($text);\n894\t    my @out = map { $_->[0] } @lexed;\n895\t    if ($depth < 3) {\n896\t      push @out, inspected_segments($_, $depth + 1) for piped_scripts(@lexed);\n897\t    }\n898\t    return @out;\n899\t  }\n900\t\n901\t  my $cmd_scan = do { local $/; <STDIN> };\n902\t  if ($ENV{\"MODE\"} eq \"count\") {\n903\t    my @found = grep { /\\S/ } segments($cmd_scan);\n904\t    # A hit is the pattern standing where a COMMAND name stands: the segment\n905\t    # executable, a comm